{
  "name": "webmq-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend library for WebMQ",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --emitDeclarationOnly && esbuild src/index.ts --bundle --platform=node --outfile=dist/index.js --format=esm --external:amqplib --external:ws --external:prom-client",
    "dev": "esbuild src/index.ts --bundle --platform=node --outfile=dist/index.js --format=esm --external:amqplib --external:ws --external:prom-client --watch",
    "test": "jest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "amqplib": "^0.10.3",
    "prom-client": "^15.1.3",
    "uuid": "^10.0.0",
    "webmq-protocol": "1.0.0",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.1",
    "@types/jest": "^29.5.3",
    "@types/ws": "^8.5.5",
    "esbuild": "^0.25.9",
    "jest": "^29.6.2",
    "ts-jest": "^29.1.1",
    "typescript": "^5.1.6"
  }
}
