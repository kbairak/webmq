{
  "name": "webmq-protocol",
  "version": "1.0.0",
  "description": "Shared wire protocol for WebMQ (bundle format, message types, constructors)",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly && esbuild src/index.ts --bundle --platform=neutral --outfile=dist/index.js --format=esm && esbuild src/index.ts --bundle --platform=neutral --outfile=dist/index.cjs --format=cjs",
    "test": "jest",
    "clean": "rm -rf dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^29.5.3",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.25.9",
    "jest": "^29.6.2",
    "ts-jest": "^29.1.1",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "uuid": "^10.0.0"
  }
}
