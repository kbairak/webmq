{
  "name": "mobile-chat",
  "version": "1.0.0",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "get-ip": "./get-server-ip.sh",
    "start:backend": "tsx backend.ts",
    "start:frontend": "npm run get-ip && expo start --clear",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\" --names \"backend,frontend\" --prefix-colors \"blue,green\"",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@testcontainers/rabbitmq": "^11.5.1",
    "expo": "~54.0.33",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.2",
    "webmq-backend": "file:../../packages/webmq-backend",
    "webmq-frontend": "file:../../packages/webmq-frontend"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
